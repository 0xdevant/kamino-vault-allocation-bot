# ─────────────────────────────────────────────────────────────────────────────
#  Kamino Vault Allocation Bot — configuration
#
#  The bot is simulation-only by design: every plan is validated against
#  mainnet RPC via `simulateTransaction`, never signed. There is no live mode
#  and no keypair handling. See ARCHITECTURE.md.
#
#  You can run with an EMPTY .env. Every value has a safe default in code
#  (src/config.ts). The ONLY thing the `run` command needs is PINNED_VAULTS;
#  `screen` needs nothing at all. Everything below "OPTIONAL" is just tuning.
# ─────────────────────────────────────────────────────────────────────────────

# ── The essentials ───────────────────────────────────────────────────────────

# The 3 vaults to allocate between. Run `npm run screen` first (no config
# needed) and paste its suggested line here. Required for `npm start` only.
PINNED_VAULTS=

# A dedicated RPC is strongly recommended — the public default is rate-limited.
RPC_URL=https://api.mainnet-beta.solana.com

# Underlying asset (APY is only comparable within one asset).
ASSET=USDC

# ── Capital ──────────────────────────────────────────────────────────────────
# Pretend idle cash the paper-trade allocator starts from. 0 means the bot runs
# but has nothing to allocate (useful for vault-watching / screening flows).
SIM_IDLE_USD=0

# ── OPTIONAL tuning — delete this whole block and the bot still works ────────

# Allocation
MAX_WEIGHT_PCT=40              # max share of capital in any one vault
UTIL_WEIGHT=0.2                # yield signal: weight on utilisation trend (APY = rest)
IMPROVEMENT_THRESHOLD_BPS=50   # min APY gain (bps) before bothering to rebalance

# Screen filters
MIN_AUM_USD=1000000
MAX_FEE_BPS=2000
MIN_APY_PCT=2
STABILITY_FLOOR=0.7            # require 90d APY >= this x current (reject spikes)

# Risk circuit breakers
AUM_DROP_PCT=30                # AUM drop from window peak -> warn (2x -> block)
MAX_UTIL_PCT=99.9           # weighted reserve utilisation ≥ this for ...
MAX_UTIL_SUSTAIN_MS=300000          # ... this long of consecutive polls -> block (5 min default)

# Loop
POLL_INTERVAL_MS=60000

# ── There are ~20 more advanced knobs (risk windows, curator-action lookback,
#    logging format/level, history file, screener size, …). They all have
#    sensible defaults in src/config.ts; set them only if you need to.
